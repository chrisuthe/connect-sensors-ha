#!/usr/bin/env bash
# The workspace's one verify command. CI runs the same steps as separate jobs
# (.github/workflows/ci.yml), plus HACS validation, which needs the GitHub API.
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '\n== %s\n' "$1"; }

step "Dependencies"
uv sync --locked --quiet

step "Lint (ruff)"
uv run ruff check .
uv run ruff format --check .

step "Type check (mypy)"
uv run mypy

step "Translations"
cmp custom_components/connect_sensors/strings.json \
    custom_components/connect_sensors/translations/en.json \
    || { echo "translations/en.json differs from strings.json: copy it over"; exit 1; }

step "Tests (pytest)"
uv run pytest -q

step "hassfest"
engine=$(command -v podman || command -v docker || true)
if [[ -n "$engine" ]]; then
    "$engine" run --rm -v "$PWD:/github/workspace:ro,Z" ghcr.io/home-assistant/hassfest
else
    echo "skipped: needs podman or docker (CI runs it)"
fi

step "HACS validation"
echo "CI only: it checks the repository through the GitHub API"
